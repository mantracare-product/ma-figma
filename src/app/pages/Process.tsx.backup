                          </div>
                          <div className="flex items-center gap-2">
                            <span className="text-sm" style={{ color: '#64748B', fontFamily: 'Outfit, sans-serif' }}>
                              {maxCallDuration} {maxCallDuration === 1 ? 'Minute' : 'Minutes'}
                            </span>
                            <ChevronDown className={`w-4 h-4 text-muted-foreground transition-transform ${maxCallDurationExpanded ? 'rotate-180' : ''}`} />
                          </div>
                        </div>

                        {maxCallDurationExpanded && (
                          <div className="bg-muted/10 rounded-lg p-4 mt-2 space-y-4">
                            <div>
                              <label className="block text-sm font-medium mb-2" style={{ color: '#020817', fontFamily: 'DM Sans, sans-serif' }}>
                                Duration (Minutes)
                              </label>
                              <p className="text-sm mb-3" style={{ color: '#64748B', fontFamily: 'Outfit, sans-serif' }}>
                                Set the maximum duration for calls before they are automatically ended
                              </p>
                              <input
                                type="number"
                                min="1"
                                value={maxCallDuration}
                                onChange={(e) => setMaxCallDuration(parseInt(e.target.value) || 1)}
                                className="w-full px-4 py-3 bg-white border border-border rounded-lg"
                                style={{ fontFamily: 'Outfit, sans-serif' }}
                              />
                            </div>

                            <div className="flex justify-end">
                              <Button
                                variant="primary"
                                onClick={() => {
                                  setMaxCallDurationExpanded(false);
                                  toast.success("Maximum call duration saved successfully");
                                }}
                              >
                                Save
                              </Button>
                            </div>
                          </div>
                        )}
                      </div>

                      {/* Blocked Numbers */}
                      <div className="w-full">
                        <div
                          className="flex items-center justify-between py-3 hover:bg-muted/20 transition-colors rounded-lg px-2 cursor-pointer"
                          onClick={() => setBlockedNumbersExpanded(!blockedNumbersExpanded)}
                        >
                          <div className="flex items-center gap-3">
                            <Ban className="w-5 h-5 text-primary" />
                            <div className="flex items-center gap-2">
                              <span className="text-sm font-medium" style={{ color: '#020817', fontFamily: 'Outfit, sans-serif' }}>
                                Blocked Numbers
                              </span>
                              <Tooltip text="Manage blocked phone numbers" placement="top">
                                <Info className="w-4 h-4 text-muted-foreground cursor-help" />
                              </Tooltip>
                            </div>
                          </div>
                          <div className="flex items-center gap-2">
                            {blockedNumbers.length > 0 && (
                              <div className="relative">
                                <div className="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
                                  {blockedNumbers.length}
                                </div>
                                <AlertCircle className="w-5 h-5 text-orange-500" />
                              </div>
                            )}
                            <ChevronDown className={`w-4 h-4 text-muted-foreground transition-transform ${blockedNumbersExpanded ? 'rotate-180' : ''}`} />
                          </div>
                        </div>

