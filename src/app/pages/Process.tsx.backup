                          <div className="bg-muted/10 rounded-lg p-4 mt-2 space-y-4">
                            <div className="flex justify-between items-center mb-3">
                              <h3 className="text-sm font-medium" style={{ color: '#020817', fontFamily: 'DM Sans, sans-serif' }}>
                                Blocked Phone Numbers
                              </h3>
                              <Button
                                variant="outline"
                                onClick={() => {
                                  setBlockedNumbers([...blockedNumbers, { id: Date.now(), phoneNumber: '', countryCode: '+1' }]);
                                }}
                              >
                                Add Number
                              </Button>
                            </div>

                            <div className="space-y-3 max-h-96 overflow-y-auto">
                              {blockedNumbers.map((blocked) => (
