# Groq API Key for Neural Whisper STT (/api/stt/transcribe)
# Get a free API key at https://console.groq.com/keys
# Copy this file to .env.local to enable Groq Whisper locally:
# cp .env.example .env.local

GROQ_API_KEY=

# Neural TTS (/api/tts)
# Choose ElevenLabs (multilingual) or OpenAI TTS.
# If not configured, Aria gracefully falls back to browser speechSynthesis.

# ElevenLabs (https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI TTS (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_TTS_VOICE=nova

# Optional Provider Selection: 'elevenlabs' | 'openai' (auto-detected if blank)
TTS_PROVIDER=
